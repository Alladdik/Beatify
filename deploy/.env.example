# Скопіюй цей файл у deploy/.env і заповни своїми значеннями:
#   cp deploy/.env.example deploy/.env

# Пароль БД PostgreSQL (придумай надійний)
POSTGRES_PASSWORD=change_me_strong_password

# Секретний ключ JWT — мінімум 32 символи, згенеруй випадковий:
#   openssl rand -base64 48
JWT_KEY=change_me_to_a_long_random_secret_at_least_32_chars

# Порт, на якому буде доступний сайт на VPS (nginx проксіює на нього)
APP_PORT=5000
