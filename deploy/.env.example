# Скопіюйте цей файл у deploy/.env і заповніть:   cp deploy/.env.example deploy/.env
# (deploy.sh робить це сам і генерує випадкові секрети)

# Пароль бази PostgreSQL
POSTGRES_PASSWORD=change_me_strong_password

# Секрет для підпису токенів входу — мінімум 32 символи:   openssl rand -base64 48
JWT_KEY=change_me_to_a_long_random_secret_at_least_32_chars

# Порт на сервері, де відкриється сайт без HTTPS
APP_PORT=5000
# 0.0.0.0 — доступно з мережі; 127.0.0.1 — тільки через Caddy (deploy.sh ставить сам, якщо вказано домен)
APP_BIND=0.0.0.0

# Домен для автоматичного HTTPS (Caddy + Let's Encrypt). Порожньо = без домену, лише http://IP:5000.
# Якщо вказали домен — додайте також  COMPOSE_PROFILES=https  (deploy.sh робить це сам: bash deploy/deploy.sh music.example.com)
DOMAIN=
COMPOSE_PROFILES=

# Дозволити нові реєстрації? Перший зареєстрований користувач стає адміністратором —
# зареєструйтесь першим, а потім за бажанням змініть на false.
ALLOW_REGISTRATION=true

# Додаткові дозволені origin для мобільного/десктопного застосунку (через кому). Порожньо = усі.
CORS_ORIGINS=

# (необов'язково) ключі Spotify для імпорту плейлистів — тоді їх не треба вводити в адмінці
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
