**/bin
**/obj
**/dist
**/dist-web
**/dist-electron
.git
.impeccable
.claude
temp_spotify
mobile
electron
scripts
server/wwwroot
server/uploads
server/App_Data
server/*.db
server/%TEMP%
deploy/.env
*.log
*.md
