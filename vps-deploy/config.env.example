# Скопіюйте в config.env і заповніть:   cp config.env.example config.env
# (config.env не потрапляє в git — там токен)

# Репозиторій з кодом (приватний → потрібен токен нижче)
REPO_URL=https://github.com/Alladdik/Beatify.git
BRANCH=main

# GitHub-токен лише для читання коду (приватний репозиторій):
#   GitHub → Settings → Developer settings → Personal access tokens → Fine-grained tokens
#   Repository access: Only select repositories → Beatify;  Permissions → Contents: Read-only
GITHUB_TOKEN=

# Домен для HTTPS (A-запис на IP сервера, відкриті порти 80/443). Порожньо = http://IP:5000
DOMAIN=

# Як часто перевіряти GitHub на нові зміни, хвилин (0 = вимкнути автооновлення)
AUTO_UPDATE_MINUTES=5

# Куди ставити на сервері
INSTALL_DIR=/opt/beatify
